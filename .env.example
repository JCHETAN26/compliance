# Copy to .env (docker compose reads it automatically). Every variable is optional for
# local development; defaults are shown. Never commit a real .env.

# --- Runtime mode ------------------------------------------------------------------
# development | test | production. Production refuses to start without JWT_SECRET
# (>= 32 chars) and COOKIE_SECURE=true.
APP_ENV=development
LOG_LEVEL=INFO

# --- Postgres (pgvector) -------------------------------------------------------------
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance
POSTGRES_DB=compliance
# Used when running Python services on the host (compose builds its own URL from the
# POSTGRES_* values above). The compose stack does not publish Postgres to the host.
DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5432/compliance
DATABASE_POOL_SIZE=10

# --- Redis ---------------------------------------------------------------------------
# Host-run services only; compose uses redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Auth ----------------------------------------------------------------------------
# Leave empty in development: a random secret is generated once and persisted to
# $DATA_DIR/secrets/jwt_secret (the api-data volume in compose).
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=480
JWT_ISSUER=compliance-api
JWT_AUDIENCE=compliance-web
# Must be true when served over HTTPS (required in production).
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Failed sign-ins allowed per account per window before HTTP 429.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# Persistent service data (generated secrets; uploaded files from Phase 1).
DATA_DIR=./.data

# --- Published host ports (compose) --------------------------------------------------
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8000
MODEL_SERVICE_PORT=8010
MCP_PORT=8020

# --- Web (Next.js server-side) -------------------------------------------------------
# Where the Next.js server reaches the API (compose sets http://api:8000).
API_INTERNAL_URL=http://localhost:8000

# --- MCP server ----------------------------------------------------------------------
MCP_HOST=127.0.0.1
# DNS-rebinding protection for the streamable HTTP transport.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-server:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- Docker build --------------------------------------------------------------------
# Set to "host" if the Docker daemon runs with iptables disabled (build containers
# then have no outbound network on the default bridge).
DOCKER_BUILD_NETWORK=default

# --- Integration tests (pytest) -------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://compliance:compliance@127.0.0.1:55432/compliance_test
TEST_REDIS_URL=redis://127.0.0.1:56379/15
TEST_POSTGRES_PORT=55432
TEST_REDIS_PORT=56379
