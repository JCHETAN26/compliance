# Copy to .env (docker compose reads it automatically). Every variable is optional for
# local development; defaults are shown. Never commit a real .env.

# --- Runtime mode ------------------------------------------------------------------
# development | test | production. Production refuses to start without JWT_SECRET
# (>= 32 chars) and COOKIE_SECURE=true.
APP_ENV=development
LOG_LEVEL=INFO

# --- Postgres (pgvector) -------------------------------------------------------------
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance
POSTGRES_DB=compliance
# Used when running Python services on the host (compose builds its own URL from the
# POSTGRES_* values above). The compose stack does not publish Postgres to the host.
DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5432/compliance
DATABASE_POOL_SIZE=10

# --- Redis ---------------------------------------------------------------------------
# Host-run services only; compose uses redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Auth ----------------------------------------------------------------------------
# Leave empty in development: a random secret is generated once and persisted to
# $DATA_DIR/secrets/jwt_secret (the api-data volume in compose).
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=480
JWT_ISSUER=compliance-api
JWT_AUDIENCE=compliance-web
# Must be true when served over HTTPS (required in production).
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Failed sign-ins allowed per account per window before HTTP 429.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# Persistent service data (generated secrets; uploaded files from Phase 1).
DATA_DIR=./.data

# --- Documents, uploads and ingestion ---------------------------------------------
STORAGE_DIR=./.data/storage
MAX_UPLOAD_FILE_BYTES=52428800
MAX_UPLOAD_FILES=20
MAX_UPLOAD_REQUEST_BYTES=209715200
UPLOAD_RATE_LIMIT_PER_MINUTE=60
MAX_ZIP_ENTRIES=5000
MAX_ZIP_UNCOMPRESSED_BYTES=268435456
MAX_ZIP_COMPRESSION_RATIO=200
MAX_PDF_PAGES=1000
MAX_SHEET_ROWS=50000
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=25
OCR_TIMEOUT_SECONDS=180
INGEST_PARSE_TIMEOUT_SECONDS=900
# Extra address space the isolated parser process may allocate beyond its baseline.
INGEST_PARSE_MEMORY_MB=3072
INGEST_MAX_ATTEMPTS=3
WORKER_MAX_JOBS=2
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40

# --- Embedding model + dataset cache --------------------------------------------------
# Host-run services read/write ./.cache; containers use /cache (a named volume by
# default). Set ARTIFACT_CACHE_SOURCE=./.cache to bind-mount the host cache instead
# (needed when containers have no internet; run `make fetch-artifacts` first).
ARTIFACT_CACHE_DIR=./.cache
ARTIFACT_CACHE_SOURCE=artifact-cache
ARTIFACT_AUTO_DOWNLOAD=true
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_MODEL_SHA256=3c9f31665447c8911517620762200d2245a2518d6e7208acc78cd9db317e21ad
EMBEDDING_BATCH_SIZE=32
EMBEDDING_THREADS=4

# --- Search (Phase 2) -------------------------------------------------------------------
# The API asks the model service for query embeddings (same pinned encoder as
# ingestion; queries are prefixed with EMBEDDING_QUERY_INSTRUCTION, passages are not).
MODEL_SERVICE_URL=http://localhost:8010
MODEL_SERVICE_TIMEOUT_SECONDS=10
MODEL_SERVICE_RETRIES=2
MODEL_SERVICE_THREADS=2
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
# Optional cross-encoder reranker (cross-encoder/ms-marco-MiniLM-L6-v2, Apache-2.0,
# ~91 MB, pinned + SHA-256 verified). When true and unavailable, the model service
# fails to start; it never silently searches without it.
RERANK_ENABLED=false
# --- Rule-check model (Phase 3) --------------------------------------------------------
# Verified ONNX artifact directory (manifest + SHA-256-checked files). Empty means
# <ARTIFACT_CACHE_DIR>/models/rule-check/current. Without a verified artifact the model
# service runs in untrained fallback mode: /v1/check answers 503, never a verdict.
RULE_CHECK_ARTIFACT_DIR=
# int8 (dynamic quantization, default) or fp32 (needs model.fp32.onnx in the artifact).
RULE_CHECK_VARIANT=int8
# CI smoke artifacts (tiny random backbone) are refused unless true. Tests only.
RULE_CHECK_ALLOW_SMOKE=false
RULE_CHECK_THREADS=4
# Dynamic micro-batching: run a batch at MAX_BATCH_ROWS rows or MAX_WAIT_MS after its first row.
RULE_CHECK_MAX_BATCH_ROWS=64
RULE_CHECK_MAX_WAIT_MS=5
RULE_CHECK_MAX_QUEUE_ROWS=4096
RULE_CHECK_MAX_TOKENS_PER_FORWARD=16384
# Admission before tokenization (503 when exceeded) and per-request size budget (413).
RULE_CHECK_MAX_PENDING_REQUESTS=8
RULE_CHECK_MAX_REQUEST_CHARS=400000
# Zero-shot LLM baseline (ml/baselines/llm.py) reads ANTHROPIC_API_KEY from your shell
# environment only. Do not put a real key in this file or any committed file.

# --- Review runs: LLM provider (Phase 4) ------------------------------------------------
# mock | anthropic | openai | ollama. "mock" is deterministic and offline: it reads no key
# and makes no network request; the UI shows a mock banner and results are labelled mock.
LLM_PROVIDER=mock
# Empty = provider default (mock-deterministic-v1, claude-haiku-5-5). OpenAI/Ollama need one.
LLM_MODEL=
# Keys are read from the process environment only by the selected real provider; export
# them in your shell (e.g. `read -rs ANTHROPIC_API_KEY; export ANTHROPIC_API_KEY`), never
# write them here. Compose passes them through to the API (presence check) and worker.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_EFFORT=
OPENAI_BASE_URL=https://api.openai.com
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=1024
# USD per million tokens; required for OpenAI and for Anthropic models without a built-in
# price (claude-haiku-5-5 and claude-sonnet-5-5 are built in). Set both or neither.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=

# --- Review runs: defaults and worker behaviour (Phase 4) -------------------------------
# Per-run caps (workspaces can change their defaults in Settings). Every provider attempt
# is reserved against both caps before it is sent.
REVIEW_BUDGET_TOKENS=400000
REVIEW_BUDGET_USD=1.0
REVIEW_MAX_CONCURRENCY=4
REVIEW_PAUSE_ON_NEEDS_REVIEW=false
# service = the trained model behind the model service; mock = lexical stand-in for
# offline demos/tests (refused in production).
REVIEW_RULE_CHECK_BACKEND=service
REVIEW_MODEL_TIMEOUT_SECONDS=300
REVIEW_LEASE_SECONDS=60
REVIEW_JOB_TIMEOUT_SECONDS=14400
REVIEW_START_RATE_LIMIT_PER_MINUTE=10
REVIEW_MAX_DOCUMENTS=100

# Hybrid retrieval defaults (frozen from the ContractNLI DEV split; see evals/).
SEARCH_TOP_K=8
SEARCH_CANDIDATE_K=50
SEARCH_EF_SEARCH=100
SEARCH_RRF_K=5
SEARCH_VECTOR_WEIGHT=1.0
SEARCH_KEYWORD_WEIGHT=1.5
SEARCH_KEYWORD_MODE=or
SEARCH_RERANK_CANDIDATES=30
SEARCH_STATEMENT_TIMEOUT_MS=5000
SEARCH_RATE_LIMIT_PER_MINUTE=120

# --- Demo data ------------------------------------------------------------------------
# Seeds demo@example.com / demo1234 + demo workspace on the first clean start.
# Always refused when APP_ENV=production.
SEED_DEMO=true

# --- Published host ports (compose) --------------------------------------------------
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8000
MODEL_SERVICE_PORT=8010
MCP_PORT=8020

# --- Web (Next.js server-side) -------------------------------------------------------
# Where the Next.js server reaches the API (compose sets http://api:8000).
API_INTERNAL_URL=http://localhost:8000

# --- MCP server ----------------------------------------------------------------------
MCP_HOST=127.0.0.1
# DNS-rebinding protection for the streamable HTTP transport.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-server:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- Docker build --------------------------------------------------------------------
# Set to "host" if the Docker daemon runs with iptables disabled (build containers
# then have no outbound network on the default bridge).
DOCKER_BUILD_NETWORK=default

# --- Integration tests (pytest) -------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://compliance:compliance@127.0.0.1:55432/compliance_test
TEST_REDIS_URL=redis://127.0.0.1:56379/15
TEST_POSTGRES_PORT=55432
TEST_REDIS_PORT=56379
TEST_ARTIFACT_CACHE_DIR=./.cache
